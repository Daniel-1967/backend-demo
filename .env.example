# Copy to .env and adjust as needed.

# Database
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/backend_demo

# Seeds
API_KEYS_SEED_FILE=scripts/seeds/api_keys.csv

# Webhooks (HMAC secret used to validate X-Signature)
WEBHOOK_SECRET=change_me

# Optional: override outbound ERP endpoint (defaults to local mock if not set)
# ERP_BASE_URL=http://127.0.0.1:8000/v1/_mock/erp

# App
ENV=local
LOG_LEVEL=INFO
API_BASE_PATH=/v1
OPENAPI_PATH=/v1/openapi.json
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_HEALTH_ROOT=false
